# Request a personal key at https://api.data.gov/signup/
# Local development can fall back to DEMO_KEY. The GitHub collector requires
# this value as repository Actions secret GSA_API_KEY; without it, only the
# collector no-ops while the website's scheduled board warm-up still runs.
GSA_API_KEY=

# Optional licensed valuation adapters. Never scrape consumer pricing sites.
KBB_API_KEY=
MARKETCHECK_API_KEY=
BLACKBOOK_API_KEY=
